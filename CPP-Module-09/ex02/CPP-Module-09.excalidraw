    {
      "id": "9YWdL6FkznjaeQIaG4G9D",
      "type": "text",
      "x": 314,
      "y": 926,
      "width": 394.45001220703125,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0j",
      "roundness": null,
      "seed": 1393043775,
      "version": 214,
      "versionNonce": 1544598009,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790766662974,
      "link": null,
      "locked": false,
      "text": "J(n) = (2^n - (-1)^n) / 3\nJ(0) = 0\nJ(1) = 1\nJ(2) = 1\nJ(3) = 3\nJ(4) = 5\nJ(5) = 11\nJ(6) = 21\n...\nJ(n) = J(n - 1) + 2 * J(n - 2)",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "J(n) = (2^n - (-1)^n) / 3\nJ(0) = 0\nJ(1) = 1\nJ(2) = 1\nJ(3) = 3\nJ(4) = 5\nJ(5) = 11\nJ(6) = 21\n...\nJ(n) = J(n - 1) + 2 * J(n - 2)",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
